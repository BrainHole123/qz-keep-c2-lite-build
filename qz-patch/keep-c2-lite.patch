+++ b/src/devices/keepbike/keep_protocol.cpp
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#include "keep_protocol.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace keep {
+namespace {
+
+constexpr uint8_t MetricsMarker[]{0xb5, '1', '0', '6', '/', '7', 0xff};
+
+bool readVarint(const uint8_t *&cursor, const uint8_t *end, uint64_t &value) {
+    value = 0;
+    for (unsigned shift = 0; shift <= 63 && cursor != end; shift += 7) {
+        uint8_t byte = *cursor++;
+        if (shift == 63 && byte > 1) {
+            return false;
+        }
+        value |= uint64_t(byte & 0x7f) << shift;
+        if (byte < 0x80) {
+            return true;
+        }
+    }
+    return false;
+}
+
+size_t finishFrame(Frame &frame, uint8_t seq, size_t bodySize) {
+    frame[0] = 0xa5;
+    frame[1] = 0xa5;
+    frame[2] = 0xa0;
+    frame[3] = seq;
+    put16(frame.data() + 4, bodySize);
+    const size_t crcOffset = bodySize + 6;
+    put16(frame.data() + crcOffset, crc16(frame.data(), crcOffset));
+    return crcOffset + 2;
+}
+
+} // namespace
+
+uint16_t crc16(const uint8_t *bytes, size_t size) {
+    uint16_t crc = 0;
+    for (size_t i = 0; i < size; ++i) {
+        crc ^= uint16_t(bytes[i]) << 8;
+        for (unsigned bit = 0; bit < 8; ++bit) {
+            const uint16_t polynomial = (crc & 0x8000) ? 0x1021 : 0;
+            crc = (crc << 1) ^ polynomial;
+        }
+    }
+    return crc;
+}
+
+size_t heartbeat(Frame &frame, Profile profile, uint8_t sequence, uint16_t counter, const Ride &ride) {
+    const uint8_t body[]{0x32, 0x16, 0xef, 0x23, 0x55, 0x01, 0x93, 0, 0,
+                         0x04, 0, 0, 0x01, 0xb5, '1', '0', '6', '/', '7'};
+    std::memcpy(frame.data() + 6, body, sizeof(body));
+    put16(frame.data() + 13, counter);
+    size_t end = 6 + sizeof(body);
+    if (profile == Profile::BikeCon && ride.status == 3) {
+        frame[end++] = 0xff;
+        frame[end++] = 0x20;
+        uint64_t value = uint64_t(ride.calories) * 1000;
+        while (value >= 128) {
+            frame[end++] = uint8_t(value & 0x7f) | 0x80;
+            value >>= 7;
+        }
+        frame[end++] = uint8_t(value);
+    }
+    return finishFrame(frame, sequence, end - 6);
+}
+
+size_t startRide(Frame &frame, Profile profile, uint8_t sequence, uint8_t counter) {
+    // BikeCon pre-increments its counter. Bike-FTMS-Bridge starts at 0x06.
+    const uint8_t value = counter + (profile == Profile::BikeCon);
+    const uint8_t body[]{0x32, 0x16, 0xef, 0x23, 0x55, 0x03, 0xb0, value,
+                         uint8_t(value + 9), 0x04, 0, 0, 0x02, 0xb5,
+                         '1', '0', '6', '/', '4', 0xff, 0x08, 0x03};
+    std::memcpy(frame.data() + 6, body, sizeof(body));
+    return finishFrame(frame, sequence, sizeof(body));
+}
+
+size_t setResistance(Frame &frame, uint8_t sequence, uint8_t counter, unsigned level) {
+    if (level < 1 || level > 24) return 0;
+    // Bike-FTMS-Bridge set_resistance: 106/6, protobuf field 1 = level.
+    const uint8_t body[]{0x32, 0x16, 0xef, 0x23, 0x55, 0x03, 0xb0, counter,
+                        uint8_t(counter + 9), 0x04, 0, 0, 0x02, 0xb5,
+                        '1', '0', '6', '/', '6', 0xff, 0x08, uint8_t(level)};
+    std::memcpy(frame.data() + 6, body, sizeof(body));
+    return finishFrame(frame, sequence, sizeof(body));
+}
+
+bool decodeRide(const uint8_t *payload, size_t size, Ride &ride, bool modeResistance) {
+    constexpr uint8_t AuthReply[]{0x02, 0xb5, '1', '0', '6', '/', '3'};
+    if (modeResistance && size == 12 + sizeof(AuthReply) &&
+        payload[4] == 0x55 && payload[5] == 0x45 &&
+        std::equal(std::begin(AuthReply), std::end(AuthReply), payload + 12)) {
+        ride = Ride{};
+        ride.hasAuthReply = true;
+        ride.authSession = le16(payload + 6) | (uint32_t(le16(payload + 8)) << 16);
+        return true;
+    }
+    // C2 Lite 1.0.4 responds to rejected writes with a 4.01 code in the
+    // message header and the 106/6 path, without a Protobuf body.
+    constexpr uint8_t DeniedResistance[]{0x02, 0xb5, '1', '0', '6', '/', '6'};
+    if (modeResistance && size == 12 + sizeof(DeniedResistance) &&
+        payload[4] == 0x55 && payload[5] == 0x81 &&
+        std::equal(std::begin(DeniedResistance), std::end(DeniedResistance), payload + 12)) {
+        ride = Ride{};
+        ride.resistanceUnauthorized = true;
+        return true;
+    }
+    const uint8_t *end = payload + size;
+    const uint8_t *marker = std::search(payload, end, std::begin(MetricsMarker), std::end(MetricsMarker));
+    constexpr uint8_t ModeMarker[]{0xb5, '1', '0', '6', '/', '6', 0xff};
+    bool modeReport = false;
+    if (marker == end && modeResistance) {
+        marker = std::search(payload, end, std::begin(ModeMarker), std::end(ModeMarker));
+        modeReport = marker != end;
+    }
+    if (marker == end) return false;
+    const uint8_t *cursor = marker + sizeof(MetricsMarker);
+    Ride result{};
+    bool hasMetrics = false;
+    while (cursor < end) {
+        uint64_t key = 0;
+        uint64_t value = 0;
+        if (!readVarint(cursor, end, key) || key < 8 || key > UINT32_MAX) {
+            return false;
+        }
+        const uint32_t field = key >> 3;
+        const unsigned wireType = key & 7;
+        switch (wireType) {
+        case 0:
+            if (!readVarint(cursor, end, value)) {
+                return false;
+            }
+            break;
+        case 2: {
+            uint64_t length = 0;
+            if (!readVarint(cursor, end, length) || length > uint64_t(end - cursor)) {
+                return false;
+            }
+            // Both reference clients also accept a little-endian byte value.
+            if (field >= 2 && field <= 8) {
+                if (length == 0 || length > 4) {
+                    return false;
+                }
+                for (unsigned i = 0; i < length; ++i) {
+                    value |= uint64_t(cursor[i]) << (8 * i);
+                }
+            }
+            cursor += length;
+            break;
+        }
+        case 1:
+        case 5: {
+            const ptrdiff_t length = wireType == 1 ? 8 : 4;
+            if (end - cursor < length) {
+                return false;
+            }
+            cursor += length;
+            continue;
+        }
+        default:
+            return false;
+        }
+        if (field >= 2 && field <= 8 && value > UINT32_MAX) {
+            return false;
+        }
+        if (modeReport) {
+            if (field == 1) {
+                if (wireType != 0 || value < 1 || value > 24) return false;
+                result.resistance = value;
+            }
+            continue;
+        }
+        switch (field) {
+        case 2: result.distance = value; result.hasDistance = true; break;
+        case 3: result.seconds = value; result.hasSeconds = true; break;
+        case 4: result.calories = value; break;
+        case 5: if (!modeResistance) result.resistance = value; break;
+        case 6: result.cadence = value; hasMetrics = true; break;
+        case 7: result.power = value; hasMetrics = true; break;
+        case 8: result.status = value; result.hasStatus = true; break;
+        default: break;
+        }
+    }
+    if (modeReport) {
+        if (!result.resistance) return false;
+        result.resistanceOnly = true;
+        ride = result;
+        return true;
+    }
+    if (!hasMetrics && !result.hasStatus && !(result.hasSeconds && result.hasDistance)) {
+        return false;
+    }
+    ride = result;
+    return true;
+}
+
+void Receiver::discard(size_t size) {
+    used -= size;
+    std::memmove(buffer.data(), buffer.data() + size, used);
+}
+
+bool Receiver::push(uint8_t byte, Ride &ride) {
+    buffer[used++] = byte;
+    while (used >= 2) {
+        if (buffer[0] != 0xa5 || buffer[1] != 0xa5) {
+            discard(1);
+            continue;
+        }
+        if (used < 6) {
+            break;
+        }
+        const size_t payloadSize = le16(buffer.data() + 4);
+        const size_t frameSize = payloadSize + 8;
+        if (frameSize > buffer.size()) {
+            ++badFrames;
+            discard(1);
+            continue;
+        }
+        if (used < frameSize) {
+            break;
+        }
+        if (crc16(buffer.data(), frameSize - 2) != le16(buffer.data() + frameSize - 2)) {
+            ++badFrames;
+            discard(1);
+            continue;
+        }
+        const bool decoded = decodeRide(buffer.data() + 6, payloadSize, ride, modeResistance);
+        discard(frameSize);
+        if (decoded) {
+            return true;
+        }
+    }
+    return false;
+}
+
+std::array<uint8_t, 8> indoorBikeData(uint16_t speedHundredths, uint32_t cadence, uint32_t watts) {
+    std::array<uint8_t, 8> bytes{0x44, 0}; // Speed, instantaneous cadence, instantaneous power
+    put16(bytes.data() + 2, std::min<uint16_t>(speedHundredths, 65534));
+    put16(bytes.data() + 4, std::min<uint32_t>(cadence, 32767) * 2);
+    put16(bytes.data() + 6, std::min<uint32_t>(watts, 32766));
+    return bytes;
+}
+
+} // namespace keep
