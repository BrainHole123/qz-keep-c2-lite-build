@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace keep {
+
+constexpr size_t MaxFrame = 512;
+using Frame = std::array<uint8_t, MaxFrame>;
+
+enum class Profile { Bridge, BikeCon };
+
+struct Ride {
+    uint32_t distance = 0;
+    uint32_t seconds = 0;
+    uint32_t calories = 0;
+    uint32_t resistance = 0;
+    uint32_t cadence = 0;
+    uint32_t power = 0;
+    uint32_t status = 0;
+    bool resistanceOnly = false;
+    bool resistanceUnauthorized = false;
+    bool hasAuthReply = false;
+    uint32_t authSession = 0;
+    bool hasDistance = false;
+    bool hasSeconds = false;
+    bool hasStatus = false;
+};
+
+inline uint16_t le16(const uint8_t *bytes) {
+    return bytes[0] | (uint16_t(bytes[1]) << 8);
+}
+
+inline void put16(uint8_t *bytes, uint16_t value) {
+    bytes[0] = value & 0xff;
+    bytes[1] = value >> 8;
+}
+
+uint16_t crc16(const uint8_t *bytes, size_t size);
+size_t heartbeat(Frame &frame, Profile profile, uint8_t sequence, uint16_t counter, const Ride &ride);
+size_t startRide(Frame &frame, Profile profile, uint8_t sequence, uint8_t counter);
+size_t setResistance(Frame &frame, uint8_t sequence, uint8_t counter, unsigned level);
+bool decodeRide(const uint8_t *payload, size_t size, Ride &ride, bool modeResistance = false);
+std::array<uint8_t, 8> indoorBikeData(uint16_t speedHundredths, uint32_t cadence, uint32_t watts);
+
+class Receiver {
+public:
+    explicit Receiver(bool modeResistance = false) : modeResistance(modeResistance) {}
+    void clear() { used = 0; }
+    bool push(uint8_t byte, Ride &ride);
+    unsigned badFrames = 0;
+
+private:
+    bool modeResistance;
+    void discard(size_t size);
+    Frame buffer{};
+    size_t used = 0;
+};
+
+} // namespace keep
