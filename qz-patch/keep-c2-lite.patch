+void keepbike::initC2Lite() {
+    const QString dataPath = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+    QFile file(dataPath + QStringLiteral("/keep-c2-lite.json"));
+    c2AuthPut = false;
+    c2AuthConfirmed = false;
+    QJsonObject identity;
+    if (file.exists()) {
+        if (!file.open(QIODevice::ReadOnly)) {
+            qDebug().noquote() << QStringLiteral("Keep C2 Lite: cannot read optional identity file");
+            return;
+        }
+        identity = QJsonDocument::fromJson(file.read(16385)).object();
+    } else {
+        // Same upstream QZ payloads tested against C2 Lite firmware 1.0.4.
+        // The default handshake was sufficient for telemetry on that bicycle.
+        newProtocolSession = static_cast<quint32>(QDateTime::currentMSecsSinceEpoch() & 0xffffffff);
+        QJsonArray packets;
+        QList<QByteArray> payloads{
+            QByteArray::fromHex("01b3312f31ff6134633664323438353566623930376300"),
+            QByteArray::fromHex("046100553130362f33ff0a18353966393532633231636633643130393064366138376333121066643265353031653665356464363230"),
+            QByteArray::fromHex("046100553130362f36"),
+            QByteArray::fromHex("046100553130362f34")};
+        QFile localAuth(dataPath + QStringLiteral("/keep-c2-auth.bin"));
+        if (localAuth.open(QIODevice::ReadOnly)) {
+            QByteArray auth = localAuth.read(51);
+            if (auth.size() == 50 && auth.startsWith(QByteArray::fromHex("0a18")) &&
+                auth.mid(26, 2) == QByteArray::fromHex("1210") &&
+                uint8_t(auth.at(44)) == 0x1d && uint8_t(auth.at(49)) == 0x20) {
+                appendVarint(auth, quint32(QDateTime::currentSecsSinceEpoch()));
+                payloads[1] = QByteArray::fromHex("02b53130362f33ff") + auth;
+                c2AuthPut = true;
+            } else {
+                qDebug() << "Keep C2 Lite: invalid local auth template";
+            }
+        }
+        uint16_t sequence = 0x00a0;
+        for (const auto &payload : payloads) {
+            packets.append(QString::fromLatin1(buildNewProtocolFrame(sequence, newProtocolSession, payload).toHex()));
+            sequence += 0x0100;
+        }
+        identity.insert(QStringLiteral("profile"), QStringLiteral("QZ"));
+        identity.insert(QStringLiteral("handshake_packets"), packets);
+    }
+    const QString bikeName = identity.value(QStringLiteral("bike_name")).toString();
+    if (!bikeName.isEmpty() && bikeName != QStringLiteral("Unknown") &&
+        bikeName.compare(bluetoothDevice.name(), Qt::CaseInsensitive) != 0) {
+        qDebug().noquote() << QStringLiteral("Keep C2 Lite: identity bike_name differs from selected device");
+        return;
+    }
+    const QString profile = identity.value(QStringLiteral("profile")).toString(QStringLiteral("Bridge"));
+    if (profile != QStringLiteral("Bridge") && profile != QStringLiteral("BikeCon") && profile != QStringLiteral("QZ")) {
+        qDebug().noquote() << QStringLiteral("Keep C2 Lite: profile must be QZ, Bridge or BikeCon");
+        return;
+    }
+
+    const auto packets = identity.value(QStringLiteral("handshake_packets")).toArray();
+    if (packets.isEmpty() || packets.size() > 4) {
+        qDebug().noquote() << QStringLiteral("Keep C2 Lite: expected 1–4 captured handshake frames");
+        return;
+    }
+    QList<QByteArray> validated;
+    int previousSequence = -1;
+    for (const auto &packet : packets) {
+        const auto value = packet.toString();
+        bool validHex = !value.isEmpty() && value.size() % 2 == 0;
+        for (const QChar character : value) {
+            const ushort code = character.unicode();
+            if (!((code >= '0' && code <= '9') || (code >= 'a' && code <= 'f') ||
+                  (code >= 'A' && code <= 'F'))) validHex = false;
+        }
+        if (value.size() > int(keep::MaxFrame * 2) || !validHex) {
+            qDebug().noquote() << QStringLiteral("Keep C2 Lite: invalid handshake hex");
+            return;
+        }
+        const auto frame = QByteArray::fromHex(value.toLatin1());
+        if (!frame.startsWith(QByteArray::fromHex("a5a5a0")) || !isNewProtocolFrame(frame) ||
+            uint8_t(frame.at(3)) > 3 || uint8_t(frame.at(3)) <= previousSequence) {
+            qDebug().noquote() << QStringLiteral("Keep C2 Lite: invalid handshake frame length, CRC or sequence");
+            return;
+        }
+        previousSequence = uint8_t(frame.at(3));
+        validated.append(frame);
+    }
+
+    c2UseQzProtocol = profile == QStringLiteral("QZ");
+    if (c2UseQzProtocol) {
+        if (validated.size() != 4 || previousSequence != 3 || validated.first().size() < 18) return;
+        const auto &first = validated.first();
+        newProtocolSession = 0;
+        for (unsigned i = 0; i < 4; ++i) newProtocolSession |= quint32(uint8_t(first.at(12 + i))) << (8 * i);
+    }
+    ++c2WriteGeneration;
+    c2Profile = profile == QStringLiteral("BikeCon") ? keep::Profile::BikeCon : keep::Profile::Bridge;
+    c2Handshake = validated;
+    c2Receiver = keep::Receiver{true};
+    c2Notifies = 0;
+    c2HasData = false;
+    c2Sequence = c2Profile == keep::Profile::Bridge ? 4 : 0;
+    c2Counter = c2Profile == keep::Profile::Bridge ? 0x1104 : 0xa400;
+    c2StartCounter = 6;
+    c2ResistanceTarget = -1;
+    c2ResistanceAttempts = 0;
+    c2ResistanceSentAt = -2000;
+    c2ResistanceQueryPending = false;
+    c2ResistanceUnauthorized = false;
+    c2Clock.start();
+    c2NextSend = 0;
+    c2LastRx = 0;
+    resetC2LiteMetrics();
+    initDone = true;
+    qDebug().noquote() << QStringLiteral("Keep C2 Lite: replaying %1 handshake frames (%2)")
+                   .arg(c2Handshake.size()).arg(profile);
+}
+
+void keepbike::writeC2Lite(const QByteArray &frame) {
+    const auto properties = gattWriteCharacteristic.properties();
+    const bool canWrite = properties.testFlag(QLowEnergyCharacteristic::Write);
+    const bool noResponse = properties.testFlag(QLowEnergyCharacteristic::WriteNoResponse);
+    const quint64 generation = ++c2WriteGeneration;
+    // On this 1.0.4 bicycle a 43-byte write succeeded, while the 74-byte
+    // auth write returned ATT 0x0d. 20-byte Write Commands delivered it.
+    // 43 is a conservative observed bound, not a claimed negotiated MTU.
+    if (canWrite && (!noResponse || (frame.size() <= 43 && c2Profile == keep::Profile::Bridge))) {
+        gattCommunicationChannelService->writeCharacteristic(
+            gattWriteCharacteristic, frame, QLowEnergyService::WriteWithResponse);
+        return;
+    }
+    const QPointer<QLowEnergyService> service(gattCommunicationChannelService);
+    for (int offset = 0; offset < frame.size(); offset += 20) {
+        const QByteArray chunk = frame.mid(offset, 20);
+        QTimer::singleShot((offset / 20) * 10, this, [this, service, generation, chunk]() {
+            if (!initDone || generation != c2WriteGeneration || !service ||
+                service->state() != QLowEnergyService::ServiceDiscovered) return;
+            service->writeCharacteristic(gattWriteCharacteristic, chunk, QLowEnergyService::WriteWithoutResponse);
+        });
+    }
+    c2NextSend = qMax(c2NextSend, c2Clock.elapsed() + ((frame.size() + 19) / 20) * 10 + 100);
+}
+
+void keepbike::updateC2Lite() {
+    const qint64 now = c2Clock.elapsed();
+    if (now - c2LastRx >= 20000) {
+        qDebug().noquote() << QStringLiteral("Keep C2 Lite: telemetry timeout, FF01 notifications=%1, CRC/length errors=%2")
+                       .arg(c2Notifies).arg(c2Receiver.badFrames);
+        initDone = false;
+        resetC2LiteMetrics();
+        m_control->disconnectFromDevice();
+        return;
+    }
+    if (now - c2LastRx >= 4000) {
+        resetC2LiteMetrics();
+    }
+    update_metrics(false, watts());
+    if (c2ResistanceUnauthorized || (c2UseQzProtocol && !c2AuthPut) ||
+        noWriteResistance || !autoResistance()) {
+        requestResistance = -1;
+        c2ResistanceTarget = -1;
+    } else if (requestResistance != -1) {
+        const int target = qBound(1, int(requestResistance), 24);
+        requestResistance = -1;
+        if (target != c2ResistanceTarget) {
+            c2ResistanceTarget = target;
+            c2ResistanceAttempts = 0;
+        }
+    }
+    if (c2ResistanceTarget > 0 && c2HasData && int(c2LastRide.resistance) == c2ResistanceTarget) {
+        qDebug() << "Keep C2 Lite: resistance confirmed by telemetry" << c2ResistanceTarget;
+        c2ResistanceTarget = -1;
+    }
+    requestStop = -1;
+    if (now < c2NextSend) {
+        return;
+    }
+
+    if (!c2Handshake.isEmpty()) {
+        writeC2Lite(c2Handshake.takeFirst());
+        c2NextSend = qMax(c2NextSend, now + 300);
+        return;
+    }
+
+    keep::Frame frame{};
+    if (requestStart != -1) {
+        requestStart = -1;
+        // Avoid issuing a second Start if the user already started on the bike.
+        if (c2LastRide.status != 3) {
+            const size_t size = keep::startRide(frame, c2Profile, c2Sequence++, c2StartCounter++);
+            writeC2Lite(QByteArray(reinterpret_cast<const char *>(frame.data()), int(size)));
+            qDebug().noquote() << QStringLiteral("Keep C2 Lite: sent Start");
+        }
+        emit bikeStarted();
+        c2NextSend = qMax(c2NextSend, now + 300);
+        return;
+    }
+
+    if (c2ResistanceQueryPending) {
+        c2ResistanceQueryPending = false;
+        writeC2Lite(buildNewProtocolFrame(uint16_t(0x00a0 | (uint16_t(c2Sequence++) << 8)),
+                                         newProtocolSession, QByteArray::fromHex("046100553130362f36")));
+        c2NextSend = qMax(c2NextSend, now + 300);
+        return;
+    }
+
+    // At most one command per two seconds. Keep polling between attempts;
+    // a GATT write ACK alone is not proof that the bike changed resistance.
+    if (c2ResistanceTarget > 0 && (!c2AuthPut || c2AuthConfirmed) &&
+        c2HasData && c2LastRide.status == 3 && now - c2LastRx < 4000 &&
+        now - c2ResistanceSentAt >= 2000) {
+        if (c2ResistanceAttempts >= 3) {
+            qDebug() << "Keep C2 Lite: resistance not confirmed; giving up target" << c2ResistanceTarget;
+            c2ResistanceTarget = -1;
+        } else {
+            if (c2AuthPut) {
+                QByteArray payload = QByteArray::fromHex("02b53130362f36ff08");
+                payload.append(char(c2ResistanceTarget));
+                writeC2Lite(buildNewProtocolFrame(uint16_t(0x00a0 | (uint16_t(c2Sequence++) << 8)),
+                                                 newProtocolSession, payload));
+            } else {
+                const size_t size = keep::setResistance(frame, c2Sequence++, c2StartCounter++, unsigned(c2ResistanceTarget));
+                writeC2Lite(QByteArray(reinterpret_cast<const char *>(frame.data()), int(size)));
+            }
+            c2ResistanceSentAt = now;
+            c2ResistanceQueryPending = c2UseQzProtocol;
+            ++c2ResistanceAttempts;
+            qDebug() << "Keep C2 Lite: requested resistance" << c2ResistanceTarget << "attempt" << c2ResistanceAttempts;
+            c2NextSend = qMax(c2NextSend, now + 300);
+            return;
+        }
+    }
+
+    if (c2UseQzProtocol) {
+        writeC2Lite(buildNewProtocolFrame(uint16_t(0x00a0 | (uint16_t(c2Sequence++) << 8)),
+                                         newProtocolSession, QByteArray::fromHex("01b53130362f37")));
+    } else {
+        const size_t size = keep::heartbeat(frame, c2Profile, c2Sequence++, c2Counter, c2LastRide);
+        writeC2Lite(QByteArray(reinterpret_cast<const char *>(frame.data()), int(size)));
+    }
+    c2Counter += c2Profile == keep::Profile::Bridge ? 1 : 257;
+    c2NextSend = now + 1000;
+}
+
+void keepbike::readC2Lite(const QByteArray &bytes) {
+    ++c2Notifies;
+    for (const char byte : bytes) {
+        keep::Ride ride;
+        if (!c2Receiver.push(uint8_t(byte), ride)) {
+            continue;
+        }
+
+        if (ride.hasAuthReply) {
+            if (c2AuthPut && ride.authSession == newProtocolSession && !c2AuthConfirmed) {
+                c2AuthConfirmed = true;
+                qDebug() << "Keep C2 Lite: control session confirmed";
+            }
+            continue;
+        }
+        if (ride.resistanceUnauthorized) {
+            if (!c2ResistanceUnauthorized) {
+                qDebug() << "Keep C2 Lite: bike returned 4.01 Unauthorized; disabling resistance writes for this connection";
+                c2ResistanceUnauthorized = true;
+                c2ResistanceTarget = -1;
+                requestResistance = -1;
+                c2ResistanceQueryPending = false;
+            }
+            continue;
+        }
+        if (ride.resistanceOnly) {
+            c2LastRide.resistance = ride.resistance;
+            Resistance = ride.resistance;
+            emit resistanceRead(Resistance.value());
+            m_pelotonResistance = bikeResistanceToPeloton(Resistance.value());
+            qDebug() << "Keep C2 Lite: actual resistance (106/6)" << ride.resistance;
+            continue;
+        }
+        // Firmware 1.0.4 reports physical gear in 106/6 field 1.
+        // 106/7 field 5 stayed at 1 during a verified manual 1-4-1 sweep.
+        ride.resistance = c2LastRide.resistance;
+        if (!ride.hasStatus) {
+            ride.status = c2LastRide.status;
+        }
+        const bool active = ride.status != 1 && ride.status != 2 && ride.status != 4;
+        QSettings settings;
+        if (settings.value(QZSettings::cadence_sensor_name, QZSettings::default_cadence_sensor_name)
+                .toString().startsWith(QStringLiteral("Disabled"))) {
+            Cadence = active ? qMin<uint32_t>(ride.cadence, 32767) : 0;
+        }
+        m_watt = active ? qMin<uint32_t>(ride.power, 32766) : 0;
+
+        if (!active) {
+            Speed = 0;
+        } else if (ride.hasDistance && c2LastRide.hasDistance && ride.hasSeconds && c2LastRide.hasSeconds) {
+            if (ride.seconds > c2LastRide.seconds && ride.distance >= c2LastRide.distance) {
+                Speed = 3.6 * (ride.distance - c2LastRide.distance) / (ride.seconds - c2LastRide.seconds);
+            } else if (ride.seconds < c2LastRide.seconds || ride.distance < c2LastRide.distance) {
+                Speed = 0;
+            }
+        }
+        if (ride.resistance > 0 && ride.resistance <= max_resistance) {
+            Resistance = ride.resistance;
+            emit resistanceRead(Resistance.value());
+            m_pelotonResistance = bikeResistanceToPeloton(Resistance.value());
+        }
+
+        if (!c2HasData || ride.status != c2LastRide.status) {
+            qDebug().noquote() << QStringLiteral("Keep C2 Lite: telemetry state=%1, cadence=%2 rpm, power=%3 W")
+                           .arg(ride.status).arg(ride.cadence).arg(ride.power);
+        }
+        c2LastRide = ride;
+        c2LastRx = c2Clock.elapsed();
+        c2HasData = true;
+    }
+}
+
+void keepbike::resetC2LiteMetrics() {
+    c2LastRide = keep::Ride{};
+    Cadence = 0;
+    m_watt = 0;
+    Speed = 0;
+}
